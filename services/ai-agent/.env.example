# Định danh instance (mặc định: hostname), dùng làm Kafka client id
INSTANCE_ID=

# ===== Kafka =====
KAFKA_BROKERS=localhost:9092
KAFKA_ANOMALY_TOPIC=anomalies
KAFKA_DECISION_TOPIC=decisions
KAFKA_ACTION_RESULT_TOPIC=action_results
KAFKA_CONSUMER_GROUP=ai-agent

# ===== LLM (API tương thích OpenAI) =====
# ollama | vllm | openai_compat | none (chỉ dùng mẫu văn bản)
LLM_PROVIDER=ollama
# Trống = mặc định theo provider (ollama: http://localhost:11434/v1, vllm: http://localhost:8000/v1)
LLM_BASE_URL=
LLM_MODEL=gemma:latest
# Chỉ cần khi server yêu cầu (vd vLLM chạy với --api-key)
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=600
# json_schema (server ép đúng schema) | json_object | none
LLM_RESPONSE_FORMAT=json_schema
# Tham số riêng của server (JSON). Model có chế độ thinking (Qwen3/3.5) PHẢI tắt, nếu không sẽ không trả lời kịp:
#   Ollama:  {"reasoning_effort": "none"}
#   vLLM:    {"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY=

# ===== Telegram =====
# Token từ @BotFather. Để trống = chỉ in thông báo ra log, duyệt qua API.
TELEGRAM_BOT_TOKEN=
# Chat/group nhận đề xuất
TELEGRAM_CHAT_ID=
# User ID được phép duyệt và ra lệnh, cách nhau bằng dấu phẩy
TELEGRAM_ADMIN_IDS=

# ===== API =====
API_HOST=127.0.0.1
API_PORT=5003
# Bắt buộc để duyệt qua API (header X-API-Token). Trống = tắt API duyệt.
API_TOKEN=

# Trống = mặc định trong thư mục service
AGENT_CONFIG=
REPORT_DIR=
LOG_LEVEL=INFO
