# Định danh instance (mặc định: hostname), dùng làm Kafka client id
INSTANCE_ID=

# ===== Kafka =====
# Chạy trên host: localhost:9092 | trong mạng docker: kafka:29092
KAFKA_BROKERS=localhost:9092
# Topic đầu vào, do packet-normalizer tạo
KAFKA_INPUT_TOPIC=packets_normalized
KAFKA_ANOMALY_TOPIC=anomalies
# Hồ sơ hành vi theo cửa sổ, dữ liệu train ML về sau. Để trống để tắt.
KAFKA_FEATURES_TOPIC=host_features
KAFKA_CONSUMER_GROUP=anomaly-detection
KAFKA_TOPIC_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
# 30 ngày / 7 ngày
KAFKA_ANOMALY_RETENTION_MS=2592000000
KAFKA_FEATURES_RETENTION_MS=604800000

# File ngưỡng phát hiện (mặc định: config/detection.yaml của service)
DETECTION_CONFIG=

LOG_LEVEL=INFO
