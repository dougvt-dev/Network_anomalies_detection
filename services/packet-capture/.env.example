# Định danh máy thu (mặc định: hostname)
SENSOR_ID=sensor-01

# ===== Capture =====
# local: bắt trên card mạng | pcap: replay file
CAPTURE_SOURCE=local
# Khi máy thu làm gateway: dùng card phía LAN (vd wlan0, ap0, eth1)
CAPTURE_INTERFACE=eth0
# BPF filter cho live capture, vd: not port 22
CAPTURE_BPF_FILTER=
# Display filter của tshark (-Y), áp dụng cho mọi nguồn
CAPTURE_DISPLAY_FILTER=
PCAP_FILE=
CAPTURE_AUTOSTART=false
TSHARK_PATH=tshark
RESTART_BACKOFF_MAX=30

# ===== Kafka =====
# Chạy trên host / container network_mode host: localhost:9092 | trong mạng docker: kafka:29092
KAFKA_BROKERS=localhost:9092
KAFKA_RAW_TOPIC=packets_raw
KAFKA_TOPIC_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
# 6 giờ
KAFKA_RAW_RETENTION_MS=21600000

# ===== API =====
API_HOST=0.0.0.0
API_PORT=5001
LOG_LEVEL=INFO
